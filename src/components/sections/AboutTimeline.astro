---
export interface Props { locale: 'zh' | 'en'; }
const { locale } = Astro.props;
const items = locale==='zh' ? [
  { year: '2024', title: '启程', desc: '开始系统学习 Web 开发，掌握 HTML/CSS/JavaScript' },
  { year: '2025', title: '进阶', desc: '深入 React/TypeScript，构建待办与博客系统' },
  { year: '2026', title: '探索', desc: '专注 Astro 极简美学与性能，打造个人作品集' },
] : [
  { year: '2024', title: 'Begin', desc: 'Started web development with HTML/CSS/JavaScript' },
  { year: '2025', title: 'Level Up', desc: 'Deep dive into React/TypeScript, built todo & blog' },
  { year: '2026', title: 'Explore', desc: 'Focus on Astro minimalism & performance' },
];
---
<div class="relative border-l border-[var(--color-border)] ml-4 pl-8 space-y-8">
  {items.map(item=>(
    <div class="relative">
      <div class="absolute -left-[37px] top-1 w-3 h-3 rounded-full bg-[var(--color-accent)] border-2 border-[var(--color-bg)]"></div>
      <div class="text-sm text-[var(--color-text-muted)]">{item.year}</div>
      <h3 class="font-semibold">{item.title}</h3>
      <p class="text-sm text-[var(--color-text-secondary)]">{item.desc}</p>
    </div>
  ))}
</div>
