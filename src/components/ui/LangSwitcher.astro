---
export interface Props {
  locale: 'zh' | 'en';
  currentPath: string;
}

const { locale, currentPath } = Astro.props;

// Import translations
import zh from '../../../content/i18n/zh.json';
import en from '../../../content/i18n/en.json';
const t = locale === 'zh' ? zh : en;

// Determine the other locale and path
const otherLocale = locale === 'zh' ? 'en' : 'zh';
const otherLocaleLabel = locale === 'zh' ? 'English' : '中文';

// Build the URL for the other language
// default locale 'en' has no prefix per astro.config routing
const rawBase = currentPath.replace(/^\/(zh)/, '') || '/';
const basePath = rawBase.startsWith('/') ? rawBase : `/${rawBase}`;
const otherLocalePath = otherLocale === 'en'
  ? (basePath === '/' ? '/' : basePath)
  : (basePath === '/' ? '/zh/' : `/zh${basePath}`);
---

<button
  class="lang-switcher inline-flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-lg border border-[var(--color-border)] hover:bg-[var(--color-bg-secondary)] transition-colors"
  aria-label={`Switch to ${otherLocaleLabel}`}
  data-lang-switch
  data-target-path={otherLocalePath}
>
  <span class="w-4 h-4">
    {otherLocale === 'zh' ? '🇨🇳' : '🇺🇸'}
  </span>
  <span>{otherLocaleLabel}</span>
</button>

<script>
  document.querySelectorAll('[data-lang-switch]').forEach((button) => {
    button.addEventListener('click', () => {
      const targetPath = button.getAttribute('data-target-path');
      if (targetPath) window.location.href = targetPath;
    });
  });
</script>

<style>
  .lang-switcher {
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }
  
  .lang-switcher:hover {
    background: var(--color-bg-secondary);
  }
</style>
