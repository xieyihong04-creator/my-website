---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/sections/Navbar.astro';
import Footer from '../../components/sections/Footer.astro';
import profile from '../../../content/profile.json';
import en from '../../../content/i18n/en.json';
const locale = 'en' as const;
const t = en;
---

<BaseLayout title={t.about.title} locale={locale} description={profile.bio.en}>
  <Navbar locale={locale} />
  <main class="container py-24 md:py-32 max-w-3xl">
    <h1 class="text-3xl md:text-4xl font-display font-bold mb-6">{t.about.title}</h1>
    <p class="text-[var(--color-text-secondary)] leading-relaxed">{profile.bio.en}</p>
    <h2 class="text-2xl font-semibold mt-12 mb-4">{t.about.journey_title}</h2>
    <p class="text-[var(--color-text-secondary)]">This page will showcase the journey. Content can be expanded from profile and skills.</p>
  </main>
  <Footer locale={locale} />
</BaseLayout>
