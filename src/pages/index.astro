---
// 导入布局
import Layout from '../layouts/Layout.astro';

// 导入组件
import Navbar from '../components/sections/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import Footer from '../components/sections/Footer.astro';

// 导入数据
import profile from '../../content/profile.json';
import site from '../../content/site.json';
---

<Layout title={site.title.zh}>
  <!-- 导航栏 -->
  <Navbar />
  
  <!-- 英雄区 -->
  <Hero profile={profile} />
  
  <!-- 关于我区域 -->
  <section class="section about">
    <div class="container">
      <h2>关于我</h2>
      <p>{profile.bio.zh}</p>
    </div>
  </section>
  
  <!-- 页脚 -->
  <Footer site={site} />
</Layout>

<style>
  .section {
    padding: 4rem 1rem;
  }
  .container {
    max-width: 1000px;
    margin: 0 auto;
  }
  h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }
  .about p {
    font-size: 1.1rem;
    line-height: 1.8;
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
    color: #444;
  }
</style>
