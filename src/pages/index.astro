---
// 1. 导入布局组件
import Layout from '../layouts/Layout.astro';

// 2. 导入您的个人数据和网站配置
import profile from '../../content/profile.json';
import site from '../../content/site.json';
---

// 3. 使用 Layout 包裹页面，并设置动态标题
<Layout title={site.title.zh}>
  <main class="container">
    <header class="hero">
      <h1>{profile.name.zh}</h1>
      <p class="tagline">{profile.tagline.zh}</p>
    </header>
    
    <section class="bio">
      <p>{profile.bio.zh}</p>
    </section>

    <section class="social">
      <a href={profile.social.github} target="_blank" rel="noopener noreferrer">我的 GitHub</a>
      <a href={`mailto:${profile.social.email}`}>发送邮件</a>
    </section>
  </main>
</Layout>

// 4. 页面专属样式 (让页面看起来更美观)
<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 1rem;
    text-align: center;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .hero h1 {
    font-size: 3rem;
    margin-bottom: 0.5rem;
    color: #1a1a1a;
  }
  .tagline {
    font-size: 1.25rem;
    color: #666;
    margin-bottom: 2rem;
  }
  .bio {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #444;
    margin-bottom: 2.5rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .social a {
    display: inline-block;
    margin: 0 10px;
    padding: 10px 20px;
    background-color: #0070f3;
    color: white;
    text-decoration: none;
    border-radius: 6px;
    font-weight: 500;
    transition: background-color 0.2s;
  }
  .social a:hover {
    background-color: #0051a8;
  }
</style>
