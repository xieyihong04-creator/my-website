---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/sections/Navbar.astro';
import Footer from '../../../components/sections/Footer.astro';
import profile from '../../../../content/profile.json';
import zh from '../../../../content/i18n/zh.json';
const locale = 'zh' as const;
const t = zh;
---

<BaseLayout title={t.about.title} locale={locale} description={profile.bio.zh}>
  <Navbar locale={locale} />
  <main class="container py-24 md:py-32 max-w-3xl">
    <h1 class="text-3xl md:text-4xl font-display font-bold mb-6">{t.about.title}</h1>
    <p class="text-[var(--color-text-secondary)] leading-relaxed">{profile.bio.zh}</p>
    <h2 class="text-2xl font-semibold mt-12 mb-4">{t.about.journey_title}</h2>
    <p class="text-[var(--color-text-secondary)]">这里将展示更多关于我的经历与成长历程。</p>
  </main>
  <Footer locale={locale} />
</BaseLayout>
