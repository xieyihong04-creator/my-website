---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/sections/Navbar.astro';
import Footer from '../../../components/sections/Footer.astro';
import { getCollection } from 'astro:content';
import zh from '../../../../content/i18n/zh.json';
const locale = 'zh' as const;
const t = zh;
const posts = (await getCollection('posts')).sort((a,b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={t.blog.title} locale={locale} description={t.blog.description}>
  <Navbar locale={locale} />
  <main class="container py-24 md:py-32">
    <h1 class="text-3xl md:text-4xl font-display font-bold mb-4">{t.blog.title}</h1>
    <p class="text-[var(--color-text-secondary)] mb-12">{t.blog.description}</p>
    <div class="grid gap-6">
      {posts.map((post) => {
        const slug = post.id.replace(/\.md$/, '');
        return (
          <article class="border border-[var(--color-border)] rounded-xl p-6 hover:shadow-md transition">
            <h2 class="text-xl font-semibold mb-2">{post.data.title[locale]}</h2>
            <p class="text-sm text-[var(--color-text-secondary)] mb-3">{post.data.description[locale]}</p>
            <a href={`/zh/blog/${slug}`} class="text-sm text-[var(--color-accent)]">{t.blog.read_more} →</a>
          </article>
        );
      })}
    </div>
  </main>
  <Footer locale={locale} />
</BaseLayout>
